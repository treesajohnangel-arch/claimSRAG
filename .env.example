# Docker Compose settings for the ClaimsRAG local development stack.
# Copy to .env (never commit a real .env). Development placeholder values only.

# PostgreSQL: used by the postgres container and passed to the backend container.
POSTGRES_DB=claimsrag
POSTGRES_USER=claimsrag
POSTGRES_PASSWORD=change-me-local-dev-only

# Backend log level: DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs go to stdout/stderr (`docker compose logs backend`).
LOG_LEVEL=INFO

# Host ports, published on 127.0.0.1 only. Change them if a port is already in use.
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5432

# Inside the Compose network the backend reaches PostgreSQL at postgres:5432; docker-compose.yml sets
# POSTGRES_HOST and POSTGRES_PORT for the container. To run the backend directly on the host instead,
# use backend/.env.example (POSTGRES_HOST=localhost, POSTGRES_PORT = POSTGRES_HOST_PORT above).
