# ClaimsRAG frontend settings. Everything prefixed VITE_ is compiled into the browser bundle: it is public, never secret.
# The API base path the browser calls. Keep the default unless the API is served under another path of this origin.
VITE_API_BASE_URL=/api

# Development only (read by vite.config.ts, not bundled): where the dev server forwards /api.
CLAIMSRAG_API_URL=http://127.0.0.1:8000
