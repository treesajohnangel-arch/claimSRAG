# Example settings for running the ClaimsRAG backend directly on the host. Safe placeholder values only.
# For local overrides, copy this file to backend/.env (never commit a real .env).
# Environment variables take precedence over values in backend/.env. When the process environment has
# ENVIRONMENT=test (pytest sets it), backend/.env is not read.

# Application. ENVIRONMENT is one of: development, test, production.
APP_NAME=ClaimsRAG
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
# Level for ClaimsRAG's own logs: DEBUG, INFO, WARNING, ERROR or CRITICAL (any case).
LOG_LEVEL=INFO

# Server bind address for `python -m app` (the uvicorn CLI takes --host/--port instead).
HOST=127.0.0.1
PORT=8000

# PostgreSQL, for running the backend directly on the host against the Docker Compose database
# (POSTGRES_PORT = POSTGRES_HOST_PORT in the root .env). The backend does not connect to it yet.
# POSTGRES_PASSWORD is a secret. With ENVIRONMENT=production it is required and must not be this placeholder.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=claimsrag
POSTGRES_USER=claimsrag
POSTGRES_PASSWORD=change-me-local-dev-only

# Access tokens: RS256-signed JWTs. JWT_PRIVATE_KEY (a secret) and JWT_PUBLIC_KEY are PEM text and are set together.
# They are required when ENVIRONMENT=production; without them the backend still starts in development, but cannot
# issue or verify tokens. Never put a real key in this file. To add a development key pair to backend/.env, run the
# commands under "Access-token keys" in CLAUDE.md; they write the keys straight into backend/.env.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# Access-token lifetime in minutes: 1 to 60 (default 15).
ACCESS_TOKEN_LIFETIME_MINUTES=15

# Grounded answers (Phase 8): a local Ollama server. The URL must name a local host (localhost, 127.0.0.1, ::1,
# ollama or host.docker.internal), so questions and policy text never leave this machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=400

# Uploaded policy PDFs: where the server stores them (default backend/.document_storage, git-ignored), and the
# largest request body accepted, in bytes (default 25 MiB, at most 200 MiB).
# DOCUMENT_STORAGE_DIR=/absolute/path/to/document-storage
MAX_UPLOAD_BYTES=26214400

# Single-company demo access (development only; refused when ENVIRONMENT=production). When both are set, the frontend
# opens directly into this company's workspace as this user, with no sign-in screen: POST /auth/demo-session issues
# their access token without a password. Anyone who can reach the API then acts as this user. Leave both unset
# otherwise.
# DEMO_COMPANY_SLUG=demo-health
# DEMO_USER_EMAIL=admin@demo-health.example
